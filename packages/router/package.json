{
  "name": "@stax-ui/router",
  "version": "0.5.3",
  "description": "Router for Stax applications",
  "type": "module",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jon Laing",
  "repository": {
    "type": "git",
    "url": "https://github.com/stax-ui/stax.git",
    "directory": "packages/router"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "router",
    "routing",
    "spa"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@stax-ui/core": "workspace:*",
    "@stax-ui/dom": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.0.0"
  }
}
