{
  "name": "@stax-ui/platform",
  "version": "0.5.5",
  "description": "Full-stack meta-framework for Stax applications",
  "type": "module",
  "license": "MPL-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jon Laing",
  "repository": {
    "type": "git",
    "url": "https://github.com/stax-ui/stax.git",
    "directory": "packages/platform"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "framework",
    "ssr",
    "full-stack",
    "meta-framework"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./node-adapter": {
      "types": "./dist/node-adapter.d.ts",
      "import": "./dist/node-adapter.js",
      "require": "./dist/node-adapter.cjs"
    },
    "./node-adapter/runtime": {
      "types": "./dist/node-adapter-runtime.d.ts",
      "import": "./dist/node-adapter-runtime.js",
      "require": "./dist/node-adapter-runtime.cjs"
    },
    "./ssg-adapter": {
      "types": "./dist/ssg-adapter.d.ts",
      "import": "./dist/ssg-adapter.js",
      "require": "./dist/ssg-adapter.cjs"
    },
    "./ssg-adapter/runtime": {
      "types": "./dist/ssg-adapter-runtime.d.ts",
      "import": "./dist/ssg-adapter-runtime.js",
      "require": "./dist/ssg-adapter-runtime.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@stax-ui/dom": "workspace:^",
    "@stax-ui/router": "workspace:^"
  },
  "peerDependencies": {
    "@effect/platform": "^0.94.0",
    "effect": "^3.0.0"
  }
}
