{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stax-ui/core": ["packages/core/src/index.ts"],
      "@stax-ui/dom": ["packages/dom/src/index.ts"],
      "@stax-ui/dom/client": ["packages/dom/src/Render/client/index.ts"],
      "@stax-ui/dom/server": ["packages/dom/src/Render/server/index.ts"],
      "@stax-ui/dom/hydrate": ["packages/dom/src/Render/hydrate/index.ts"],
      "@stax-ui/router": ["packages/router/src/index.ts"],
      "@stax-ui/form": ["packages/form/src/index.ts"],
      "@stax-ui/platform": ["packages/platform/src/index.ts"],
      "@stax-ui/platform/client": ["packages/platform/src/client.ts"],
      "@stax-ui/platform/server": ["packages/platform/src/server.ts"],
      "@stax-ui/platform/node-adapter": [
        "packages/platform/src/node-adapter.ts"
      ],
      "@stax-ui/platform/node-adapter/runtime": [
        "packages/platform/src/node-adapter-runtime.ts"
      ],
      "@stax-ui/vite-plugin": ["packages/vite-plugin/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "src"]
}
